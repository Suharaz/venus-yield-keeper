# Used only by local scripts (npm run register / list:hellofugu). Never commit .env.
# Campaign wallet (wallet A) private key: owns the ERC-8004 identity and the HelloFugu listing.
OWNER_PRIVATE_KEY=0x...
# Deployed Worker URL, e.g. https://venus-yield-keeper.<subdomain>.workers.dev
AGENT_BASE_URL=https://venus-yield-keeper.example.workers.dev
# Set after the first registration to skip re-registering.
AGENT_ID=
