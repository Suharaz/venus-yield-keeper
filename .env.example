# Used only by local scripts (npm run register / list:hellofugu). Never commit .env.
# Campaign wallet (wallet A) private key: owns the ERC-8004 identities and the HelloFugu listings.
OWNER_PRIVATE_KEY=0x...
# Yield agent (scripts default, or `-- yield`): deployed Worker URL and agentId once registered.
AGENT_BASE_URL=https://venus-yield-keeper.example.workers.dev
AGENT_ID=
# Treasury agent (`-- treasury`): same variables with the TREASURY_ prefix.
TREASURY_AGENT_BASE_URL=https://runway-treasurer.example.workers.dev
TREASURY_AGENT_ID=
# Agent wallet keys are generated by `npm run keygen [-- treasury]` into .dev.vars, not here.
