{
  "name": "venus-yield-keeper",
  "version": "0.3.0",
  "private": true,
  "description": "Three ERC-8004 agents on BNB Smart Chain testnet: Venus Yield Keeper (yield), Runway Treasurer (treasury) and Venus Rate Router (rebalancing), listed on HelloFugu, Pokter (ERC-8183) and Agent Souk.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:treasury": "wrangler dev --test-scheduled --config wrangler.treasury.jsonc",
    "dev:router": "wrangler dev --test-scheduled --config wrangler.router.jsonc",
    "deploy": "wrangler deploy",
    "deploy:treasury": "wrangler deploy --config wrangler.treasury.jsonc",
    "deploy:router": "wrangler deploy --config wrangler.router.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/router/policy.test.ts",
    "keygen": "tsx scripts/keygen.ts",
    "register": "tsx scripts/register.ts",
    "list:hellofugu": "tsx scripts/list-hellofugu.ts"
  },
  "license": "MIT",
  "dependencies": {
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
