{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "venus-yield-keeper",
  "main": "src/yield/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every 5 minutes: complete finished HelloFugu hires, then apply the yield rule.
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "adc3813cafd54e619f1245b5fd798d39" }],
  "vars": {
    "RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
    // Fill after `npm run register` / `npm run list:hellofugu`; empty = not yet registered/listed.
    "AGENT_ID": "2554",
    "LISTING_ID": "23",
    "PUBLIC_URL": "https://venus-yield-keeper.minesuhara.workers.dev",
    // Strategy parameters (basis points / wei strings).
    "MIN_APY_BPS": "100",
    "BASE_TARGET_BPS": "5000",
    "PER_HIRE_BPS": "1500",
    "MAX_TARGET_BPS": "9000",
    "BAND_BPS": "500",
    "GAS_RESERVE_WEI": "10000000000000000",
    "HARVEST_MIN_WEI": "1000000000000"
  }
  // Secret (not in this file): AGENT_PRIVATE_KEY - set with `wrangler secret put AGENT_PRIVATE_KEY`.
}
